# Copy to .env and replace the password locally. Never commit .env.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_DB=agenticdb_sj
POSTGRES_USER=agenticdb
POSTGRES_PASSWORD=replace_with_local_password

DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=5000

# Day 8 controlled execution policy
COPILOT_EXECUTION_ROLE=agenticdb_reader
COPILOT_EXECUTION_TIMEOUT_MS=15000
COPILOT_LOCK_TIMEOUT_MS=2000
COPILOT_MAX_RESULT_ROWS=1000

API_HOST=127.0.0.1
API_PORT=8000

# Day 9 agent response policy
AGENT_DEFAULT_EVIDENCE_ROWS=5
