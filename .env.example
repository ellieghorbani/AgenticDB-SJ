# Copy to .env and replace local secrets. Never commit .env.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_DB=agenticdb_sj
POSTGRES_USER=agenticdb
POSTGRES_PASSWORD=replace_with_local_password

DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=5000

# Day 8 controlled execution policy
COPILOT_EXECUTION_ROLE=agenticdb_reader
COPILOT_EXECUTION_TIMEOUT_MS=15000
COPILOT_LOCK_TIMEOUT_MS=2000
COPILOT_MAX_RESULT_ROWS=1000

API_HOST=127.0.0.1
API_PORT=8000

# Day 9 agent response policy
AGENT_DEFAULT_EVIDENCE_ROWS=5

# Day 10/11 embedding provider: local or openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=384
OPENAI_EMBEDDING_BATCH_SIZE=100
VECTOR_SEARCH_TIMEOUT_MS=15000
VECTOR_HNSW_EF_SEARCH=80

# Day 11 hosted planning provider: deterministic or openai
PLANNING_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5.6-terra
OPENAI_LLM_TIMEOUT_SECONDS=45
OPENAI_LLM_MAX_OUTPUT_TOKENS=1200
OPENAI_FALLBACK_TO_DETERMINISTIC=true

# Optional cost estimation. Keep at zero or set current USD rates per 1M tokens.
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
